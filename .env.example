# Copie este arquivo para .env e preencha (o .env nao vai para o git).
# Conta gratis: https://www.metered.ca/tools/openrelay/
#
# PAESTREAM_METERED_APP_NAME = so o nome curto do app (ex: paestream)
#   NAO use paestream.metered.live
# PAESTREAM_METERED_TURN_API_KEY = a API Key gerada no painel TURN

PAESTREAM_METERED_APP_NAME=seu-app
PAESTREAM_METERED_TURN_API_KEY=sua-api-key
